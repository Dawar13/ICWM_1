# Python environments and caches (recreate with setup.sh)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Model checkpoints and large binaries: they stay on the A100 host (~/icwm_gonogo/runs).
# Run outputs that are small text (meta.json, log.jsonl, summary.json, stdout.txt) ARE tracked:
# the gates in src/analysis/gates.py recompute every verdict from them.
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.h5
*.tgz
*.tar.gz
*.zip

# Secrets: never commit keys or credentials
*_ed25519
*_ed25519.pub
*_rsa
*_rsa.pub
*.pem
*.key
.env
.env.*

